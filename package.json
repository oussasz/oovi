{
  "name": "oovi",
  "productName": "oovi",
  "version": "0.8.6",
  "private": true,
  "license": "UNLICENSED",
  "author": "oovi",
  "description": "Your own crew of AI bots on your desktop. Bring your own API key, no subscription.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node electron/dev.cjs",
    "build": "next build && node scripts/prepare-server.mjs",
    "start": "next build && electron .",
    "dist": "npm run build && electron-builder",
    "web": "next dev -H 127.0.0.1 -p 3100",
    "typecheck": "tsc --noEmit",
    "sandbox": "docker compose up -d",
    "publish:downloads": "bash scripts/publish-downloads.sh"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "docx": "9.14.0",
    "e2b": "2.59.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "linkedom": "0.18.14",
    "marked": "18.1.1",
    "next": "15.5.29",
    "playwright-core": "1.64.0",
    "pptxgenjs": "4.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.8.3",
    "unpdf": "1.9.1"
  },
  "build": {
    "appId": "app.oovi.desktop",
    "productName": "oovi",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "electron/**",
      "!electron/dev.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "appx": {
      "identityName": "Conuron.oovi",
      "publisher": "CN=FDAA9D41-AC3C-4AB9-9C48-528D5F63CA3E",
      "publisherDisplayName": "Conuron",
      "applicationId": "oovi",
      "displayName": "oovi",
      "backgroundColor": "transparent",
      "showNameOnTiles": false,
      "languages": [
        "en-US",
        "fr-FR",
        "ar-SA",
        "es-ES",
        "de-DE",
        "tr-TR"
      ],
      "artifactName": "${productName}-Store-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "oovi",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "oussasz",
        "repo": "oovi-downloads",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US",
      "fr",
      "ar",
      "es",
      "de",
      "tr"
    ],
    "afterPack": "scripts/after-pack.cjs"
  }
}
