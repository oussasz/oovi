# oovi accounts website (Vercel). Copy to .env.local for local work; never commit real values.

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Sign-in (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://oovi.conuron.com

# Paddle checkout on /pricing.
# NEXT_PUBLIC_PADDLE_ENV is required: "production" (live account) or "sandbox". There is no default;
# if it's missing or doesn't match the token, checkout stays off and the error is logged.
NEXT_PUBLIC_PADDLE_ENV=production
# Client-side token from Paddle > Developer tools > Authentication > Client-side tokens.
# Starts with live_ for production, test_ for sandbox. It's public by design (used in the browser).
# Never put a Paddle server API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Paddle server side (secret: server only, mark as Sensitive in Vercel).
# Signing secret of the webhook destination https://<site>/api/paddle/webhook
# (Paddle > Developer tools > Notifications). Used to verify deliveries; it is not the API key.
PADDLE_WEBHOOK_SECRET=
# API key (Paddle > Developer tools > Authentication > API keys), pdl_live_… or pdl_sdbx_… to match
# NEXT_PUBLIC_PADDLE_ENV. Needed for "Manage billing" (customer portal sessions). Permissions:
# customer portal session write, customer read, subscription read.
PADDLE_API_KEY=
