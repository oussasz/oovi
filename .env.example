# Optional. Passphrase used to encrypt saved API keys.
# If unset, a random secret is generated in data/.secret on first run.
OOVI_SECRET=

# Optional. Where settings are stored (default: ./data).
OOVI_DATA=

# Optional. Extra host names allowed to reach the app (comma separated),
# e.g. when running behind a reverse proxy. Default: localhost only.
OOVI_ALLOWED_HOSTS=
